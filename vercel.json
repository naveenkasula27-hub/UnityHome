{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "client": {
      "root": "client",
      "framework": "vite",
      "installCommand": "npm ci",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "rewrites": [
        {
          "source": "/:path*",
          "destination": "/index.html"
        }
      ]
    },
    "server": {
      "root": "server",
      "framework": "express",
      "entrypoint": "index.js",
      "installCommand": "npm ci"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": {
        "service": "client",
        "path": "/index.html"
      }
    },
    {
      "source": "/api",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/api/:path*",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/:path*",
      "destination": {
        "service": "client"
      }
    }
  ]
}
